{
  "manifest_version": 3,
  "name": "NST Reminder",
  "version": "0.2.0",
  "description": "Attendance, assignment, contest and class reminders for my.newtonschool.co, with a page theme switcher",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://my.newtonschool.co/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "NST Reminder" },
  "options_page": "src/options.html",
  "content_scripts": [
    { "matches": ["https://my.newtonschool.co/*"], "js": ["src/theme.js"], "run_at": "document_start" },
    { "matches": ["https://my.newtonschool.co/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
